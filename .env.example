# Local development settings. Replace the secret with a unique value before use.
SECRET_KEY=replace-with-a-long-random-development-secret
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

# The local settings use SQLite. The main settings use PostgreSQL.
DATABASE_NAME=django_ecommerce
DATABASE_USER=postgres
DATABASE_PASSWORD=
DATABASE_HOST=localhost
DATABASE_PORT=5432

DEFAULT_FROM_EMAIL=store@example.com
NOTIFY_EMAIL=
EMAIL_HOST=localhost
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False

# Optional PayPal sandbox credentials; never use live credentials locally.
PAYPAL_ENV=sandbox
PAYPAL_SANDBOX_CLIENT_ID=
PAYPAL_SANDBOX_SECRET_KEY=

# Optional Stripe test-mode credentials.
STRIPE_PUBLIC_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Production-only examples (set explicitly in deployment configuration):
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
